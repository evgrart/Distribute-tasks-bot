# Создайте рядом файл .env. Не коммитьте его.
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=7435960767
ADMIN_USER_IDS=7435960767
TARGET_CHAT_IDS={"1":"-1000000000001","2":"-1000000000002","3":"-1000000000003"}

# URL Apps Script Web App и общий секрет моста.
SHEETS_BRIDGE_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
SHEETS_BRIDGE_SECRET=

# На первом запуске true удалит старый webhook вместе с зависшими запросами.
DROP_PENDING_UPDATES_ON_START=true
STATE_FILE=./data/state.json
SHEETS_CACHE_SECONDS=15
TELEGRAM_POLL_TIMEOUT_SECONDS=45
# 0 = чистый рандом, 0.5 = умеренный приоритет решавших больше, 1 = сильный.
SOLVED_PRIORITY_POWER=0.5
TIME_ZONE=Europe/Moscow
